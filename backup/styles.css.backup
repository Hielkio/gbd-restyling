.text-glow {
	text-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
}
.menu-item {
	transition: all 0.3s ease;
}

.section-content {
	position: relative;
	z-index: 2;
}
/* Alle secties hebben nu een gemeenschappelijke klasse */
.page-section {
	position: relative;
	z-index: 2;
	min-height: 100vh;
	display: flex;
	align-items: center;
	justify-content: center;
}
.section-bg {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	z-index: 0;
	opacity: 0;
	transition: opacity 0.3s ease-in-out; /* Toevoeging van een CSS-overgang voor soepele overgangen */
}
/* Achtergrondafbeeldingen */
.section-bg-home {
	background-image: url('../images/hq/1.jpg');
	background-size: cover;
	background-position: center;
}
.section-bg-diensten {
	background-image: url('../images/hq/13.jpg');
	background-size: cover;
	background-position: center;
}
.section-bg-voordelen {
	background-image: url('../images/hq/3.jpg');
	background-size: cover;
	background-position: center;
}
.section-bg-over-ons {
	background-image: url('../images/hq/12.jpg');
	background-size: cover;
	background-position: center;
}
.section-bg-contact {
	background-image: url('../images/hq/5.jpg');
	background-size: cover;
	background-position: center;
}
.section-overlay {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: rgba(0, 0, 0, 0.7);
	z-index: 1;
}